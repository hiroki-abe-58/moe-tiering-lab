+        for (int t = 0; t < NT; ++t) {
+            // hadd(hadd(p0, p1), hadd(p2, p3)) = [S0lo S1lo S2lo S3lo | S0hi S1hi S2hi S3hi] (lo: values 0-15, hi: 16-31)
+            const __m256i s0 = _mm256_permute2x128_si256(u[t][0], u[t][1], 0x20);   // chunks 0..7, first 16 values
+            const __m256i s1 = _mm256_permute2x128_si256(u[t][0], u[t][1], 0x31);   // chunks 0..7, last 16 values
+            __m256i q;
+            if constexpr (TY == 16) {
+                q = div_pow2(_mm256_mullo_epi32(_mm256_add_epi32(s0, s1), LA), 3);
+            } else if constexpr (TY == 18) {
+                const __m256i S = _mm256_add_epi32(s0, s1);
+                q = div_pow2(_mm256_add_epi32(_mm256_mullo_epi32(S, LA), div_pow2(S, 1)), 1);
+            } else {
+                q = div_pow2(_mm256_add_epi32(_mm256_add_epi32(_mm256_mullo_epi32(s0, LA), _mm256_mullo_epi32(s1, LB)),
+                                              div_pow2(_mm256_add_epi32(s0, s1), 1)), 2);
+            }
+            const __m256 scale = _mm256_mul_ps(_mm256_set1_ps(dx), _mm256_loadu_ps(yd[t] + 8 * i));
+            accf[t] = _mm256_fmadd_ps(_mm256_cvtepi32_ps(q), scale, accf[t]);
+        }
+    }
+    for (int t = 0; t < NT; ++t) res[t] = hsum_ggml(accf[t]);
+}
