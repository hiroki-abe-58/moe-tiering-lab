+                const int s0 = _mm_extract_epi16(_mm256_castsi256_si128(sc), 0);
+                const int s1 = _mm_extract_epi16(_mm256_extracti128_si256(sc, 1), 0);
+                if constexpr (TY == 16) {
+                    la[c] = s0;                 // 2 * (w >> 28) + 1, the device's (aux32 >> 27) | 1
+                } else {
+                    la[c] = (s0 - 1) >> 1;      // the 4-bit scale
+                    lb[c] = (s1 - 1) >> 1;
+                }
+                const int off = 256 * i + 128 * grp + 32 * k;
+                for (int t = 0; t < NT; ++t) {
+                    const __m256i yv = _mm256_loadu_si256((const __m256i*) (yq[t] + off));
+                    pc[t][k] = _mm256_madd_epi16(_mm256_maddubs_epi16(g, _mm256_sign_epi8(yv, sgn)), ones16);
+                }
+            }
+            for (int t = 0; t < NT; ++t)
+                u[t][grp] = _mm256_hadd_epi32(_mm256_hadd_epi32(pc[t][0], pc[t][1]), _mm256_hadd_epi32(pc[t][2], pc[t][3]));
