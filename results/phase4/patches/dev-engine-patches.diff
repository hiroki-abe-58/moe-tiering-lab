+// ---- 32-value activation blocks (the device's q8_1 scheme).  The activation is quantised in blocks of 32 values, each
+// with its own scale (amax / 127, rounded to FP16 as the device stores it), instead of ggml's Q8_K blocks of 256 values with
+// one: an outlier then costs the accuracy of 32 values, not 256.  Layout of n values: n / 32 floats (the FP16-rounded
+// scales), then n int8 codes.  The weights are decoded as above; each 32-value chunk's integer sum is converted to float
+// and scaled by d_x * d_y(chunk) (ggml's one scale per 256 values is what this replaces).  NOT bit-identical to ggml's dot.
+template <int TY, int NT>
+inline void row_dot_a32(const uint8_t* row, int nblocks, const float* const* yd, const int8_t* const* yq, float* res) {
+    __m256 accf[NT];
+    for (int t = 0; t < NT; ++t) accf[t] = _mm256_setzero_ps();
+    for (int i = 0; i < nblocks; ++i) {
+        const uint8_t* blk = row + (size_t) i * Fmt32<TY>::bytes;
+        const float dx = h2f(u16(blk));
+        for (int j = 0; j < 4; ++j) {
+            for (int half = 0; half < 2; ++half) {
+                __m256i g, sgn, sc;
+                Fmt32<TY>::decode(blk, j, half, g, sgn, sc);
+                const int c = 8 * i + 2 * j + half;
+                const int off = 256 * i + 64 * j + 32 * half;
+                for (int t = 0; t < NT; ++t) {
+                    const __m256i yv = _mm256_loadu_si256((const __m256i*) (yq[t] + off));
+                    const __m256i ys = _mm256_sign_epi8(yv, sgn);
+                    const __m256i p = _mm256_madd_epi16(_mm256_maddubs_epi16(g, ys), sc);
+                    accf[t] = _mm256_fmadd_ps(_mm256_set1_ps(dx * yd[t][c]), _mm256_cvtepi32_ps(p), accf[t]);
+                }
+            }
+        }
+    }
+    for (int t = 0; t < NT; ++t) res[t] = Fmt32<TY>::K * hsum_ggml(accf[t]);
+}
+
+// ---- the same with the device's integer arithmetic.  The device's i-quant dot truncates each 32-value chunk's scaled integer
+// sum before the float scale (glm_fast.cu dw<T>): IQ2_XXS sumi * ls / 8, IQ3_XXS (ls * sumi + sumi / 2) / 2, IQ2_XS / IQ2_S
+// (sumi0 * ls0 + sumi1 * ls1 + (sumi0 + sumi1) / 2) / 4 (C integer division, toward zero), each chunk's float term
+// d_w * d_y * sumi added to the row's sum.  ggml-cpu (and row_dot_a32) keep the scale in float.  Here the 8 chunks of a block are
+// reduced together (the horizontal sums of their dot products as one vector), the device's integer steps run on all 8 at once and
+// the terms are added in float.  Only the order of the float additions differs from the device.
+inline __m256i div_pow2(__m256i x, int m) {   // x / 2^m, C semantics (toward zero)
+    const __m256i bias = _mm256_and_si256(_mm256_srai_epi32(x, 31), _mm256_set1_epi32((1 << m) - 1));
+    return _mm256_srai_epi32(_mm256_add_epi32(x, bias), m);
+}
+
+template <int TY, int NT>
+inline void row_dot_a32g(const uint8_t* row, int nblocks, const float* const* yd, const int8_t* const* yq, float* res) {
+    static_assert(TY == 16 || TY == 17 || TY == 18 || TY == 22, "formats whose device dot truncates");
+    constexpr bool kTwoScales = TY == 17 || TY == 22;
+    __m256 accf[NT];
+    for (int t = 0; t < NT; ++t) accf[t] = _mm256_setzero_ps();
+    const __m256i ones16 = _mm256_set1_epi16(1);
+    for (int i = 0; i < nblocks; ++i) {
+        const uint8_t* blk = row + (size_t) i * Fmt32<TY>::bytes;
+        const float dx = h2f(u16(blk));
+        alignas(32) int32_t la[8], lb[8];   // the chunks' scales as the device reads them (0..15; IQ2_XXS: 2 * s + 1)
+        __m256i u[NT][2];                   // per token, per group of 4 chunks: [sumi0 of the 4 | sumi1 of the 4]
+        for (int grp = 0; grp < 2; ++grp) {
+            __m256i pc[NT][4];
+            for (int k = 0; k < 4; ++k) {
+                const int j = 2 * grp + (k >> 1), half = k & 1;   // chunk c = 8 * block + 4 * grp + k  (j = c / 2 in the block)
+                __m256i g, sgn, sc;
+                Fmt32<TY>::decode(blk, j, half, g, sgn, sc);
