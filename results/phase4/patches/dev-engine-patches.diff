+                   float* const* out, int r0, int r1);
+/// The same with the device's integer steps (IQ2_XXS / IQ2_XS / IQ2_S / IQ3_XXS: the scaled integer sum of each 32-value chunk
+/// truncated as the CUDA/HIP kernels do, glm_fast.cu dw<T>); the other formats are iq256a32_rows'.  Only the order of the
+/// float additions differs from the device.
+void iq256a32d_rows(int ggml_type, const uint8_t* w, size_t row_bytes, int n, const void* const* act, int nt,
+                    float* const* out, int r0, int r1);
