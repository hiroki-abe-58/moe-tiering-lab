+// src/kernels/cpu/native_a32_test.cpp - the 32-value activation rows (STRATA_GLM_CPU_ACT=q8_1, iq_avx2.cpp) against a
+// double-precision reference.  The activation quantiser must produce the device's q8_1 codes and FP16-rounded scales; the
+// rows must equal sum(w . dequantised activation) up to float accumulation, for every format they take, 1-5 tokens and row
+// ranges cut anywhere; a token's answer must not depend on how many tokens are batched with it (bit for bit); and the
+// split-base GLM rows (native_fmt_a32 + native_gu_rows_split / native_down_rows_split) must agree between one token and
+// several.  Synthetic rows (random codes, small normal block scales).  CPU only.
+#include "strata/kernels/cpu/expert_layout.hpp"
+#include "strata/kernels/cpu/iq_avx2.hpp"
+#include "strata/kernels/cpu/native_expert.hpp"
+
+#include "ggml.h"
+#include "ggml-cpu.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace {
+
+namespace cpu = strata::kernels::cpu;
+int failures = 0;
+
+std::vector<uint8_t> rand_rows(int type, int n, int rows, std::mt19937& rng) {
+    const ggml_type t = (ggml_type) type;
+    const size_t rb = ggml_row_size(t, n), bb = ggml_type_size(t);
+    std::vector<uint8_t> w(rb * rows);
+    for (auto& b : w) b = (uint8_t) rng();
+    std::uniform_real_distribution<float> ds(0.0005f, 0.02f);
+    for (size_t o = 0; o < w.size(); o += bb) {
+        const ggml_fp16_t d = ggml_fp32_to_fp16(ds(rng));
+        std::memcpy(&w[o], &d, sizeof d);
+    }
+    return w;
+}
+
+std::vector<float> rand_x(int n, std::mt19937& rng) {
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    std::vector<float> x(n);
+    for (auto& v : x) v = nd(rng) * (rng() % 64 == 0 ? 20.0f : 1.0f);   // some outliers, like real activations
+    return x;
+}
+
+// the quantiser written out again: d = min(amax / 127, 65504) rounded to FP16, code = round(v / d) clamped to +-127
+int check_quantiser(int n, std::mt19937& rng) {
+    const auto x = rand_x(n, rng);
+    std::vector<uint8_t> buf(cpu::iq256a32_bytes(n));
+    cpu::iq256a32_quantize(x.data(), n, buf.data());
+    const float* d = (const float*) buf.data();
+    const int8_t* q = (const int8_t*) (d + n / 32);
+    int bad = 0;
+    for (int b = 0; b < n / 32; ++b) {
+        float amax = 0.0f;
+        for (int j = 0; j < 32; ++j) amax = std::max(amax, std::fabs(x[32 * b + j]));
+        const float sc = std::min(amax / 127.0f, 65504.0f);
+        const float dh = ggml_fp16_to_fp32(ggml_fp32_to_fp16(sc));
+        if (d[b] != dh) ++bad;
+        for (int j = 0; j < 32; ++j) {
+            const int want = amax == 0.0f ? 0 : (int) std::max(-127.0f, std::min(127.0f, std::round(x[32 * b + j] / sc)));
+            if (q[32 * b + j] != want) ++bad;
+        }
+    }
+    return bad;
+}
+
+// rows for nt tokens against the double reference (dequantised weights . dequantised activation)
+double compare(int type, int n, int rows, int nt, std::mt19937& rng, std::vector<float>* first = nullptr) {
+    const auto w = rand_rows(type, n, rows, rng);
+    const size_t rb = ggml_row_size((ggml_type) type, n), ab = cpu::iq256a32_bytes(n);
+    std::vector<uint8_t> a(ab * nt);
+    std::vector<const void*> ap(nt);
+    std::vector<float> got((size_t) nt * rows);
+    std::vector<float*> op(nt);
+    for (int k = 0; k < nt; ++k) {
+        cpu::iq256a32_quantize(rand_x(n, rng).data(), n, a.data() + ab * k);
+        ap[k] = a.data() + ab * k;
+        op[k] = got.data() + (size_t) k * rows;
+    }
+    // two row ranges cut at an odd row, as the pool's jobs do
+    const int cut = rows / 3 + 1;
+    cpu::iq256a32_rows(type, w.data(), rb, n, ap.data(), nt, op.data(), 0, cut);
+    cpu::iq256a32_rows(type, w.data() + cut * rb, rb, n, ap.data(), nt, std::vector<float*>(op).data(), 0, 0);   // (empty)
+    {
+        std::vector<float*> op2(nt);
+        for (int k = 0; k < nt; ++k) op2[k] = op[k] + cut;
+        cpu::iq256a32_rows(type, w.data() + cut * rb, rb, n, ap.data(), nt, op2.data(), 0, rows - cut);
+    }
+    const auto* tr = ggml_get_type_traits((ggml_type) type);
+    std::vector<float> row(n);
+    double worst = 0.0;
+    for (int r = 0; r < rows; ++r) {
+        tr->to_float(w.data() + (size_t) r * rb, row.data(), n);
+        for (int k = 0; k < nt; ++k) {
+            const float* d = (const float*) ap[k];
+            const int8_t* q = (const int8_t*) (d + n / 32);
+            double s = 0.0, sa = 0.0;
+            for (int i = 0; i < n; ++i) {
+                const double p = (double) row[i] * ((double) d[i / 32] * q[i]);
+                s += p;
+                sa += std::fabs(p);
+            }
+            worst = std::max(worst, std::fabs(s - got[(size_t) k * rows + r]) / std::max(sa, 1e-30));
+        }
+    }
+    if (first) *first = got;
+    return worst;
+}
+
+using RowsFn = void (*)(int, const uint8_t*, size_t, int, const void* const*, int, float* const*, int, int);
+
+// the device-integer-steps rows against the plain 32-value rows: the device truncates each chunk's scaled sum, so the two
+// differ by at most the truncation (< 1 unit of the chunk's term, i.e. well under 1e-3 of sum|terms| here) - and the device-
+// steps rows must agree with themselves across row ranges and token counts
+double dev_vs_plain(int type, int n, int rows, int nt, std::mt19937& rng) {
+    const auto w = rand_rows(type, n, rows, rng);
+    const size_t rb = ggml_row_size((ggml_type) type, n), ab = cpu::iq256a32_bytes(n);
+    std::vector<uint8_t> a(ab * nt);
+    std::vector<const void*> ap(nt);
+    std::vector<float> g1((size_t) nt * rows), g2((size_t) nt * rows);
+    std::vector<float*> o1(nt), o2(nt);
+    for (int k = 0; k < nt; ++k) {
+        cpu::iq256a32_quantize(rand_x(n, rng).data(), n, a.data() + ab * k);
+        ap[k] = a.data() + ab * k;
+        o1[k] = g1.data() + (size_t) k * rows;
+        o2[k] = g2.data() + (size_t) k * rows;
+    }
+    cpu::iq256a32_rows(type, w.data(), rb, n, ap.data(), nt, o1.data(), 0, rows);
+    cpu::iq256a32d_rows(type, w.data(), rb, n, ap.data(), nt, o2.data(), 0, rows);
+    // scale of a row's terms: the plain row against |activation| (all positive) is not available, so bound by the largest
+    // magnitude of the row: sqrt(n) * max term would be loose; use the rms of the plain results
+    double rms = 0.0, worst = 0.0;
+    for (float v : g1) rms += (double) v * v;
+    rms = std::sqrt(rms / g1.size());
+    for (size_t i = 0; i < g1.size(); ++i) worst = std::max(worst, std::fabs((double) g1[i] - g2[i]) / std::max(rms, 1e-30));
+    return worst;
+}
+
+int check_batching_fn(RowsFn fn, int type, std::mt19937& rng);
+int check_batching(int type, std::mt19937& rng) { return check_batching_fn(cpu::iq256a32_rows, type, rng); }
+
+// token 0 alone vs token 0 with k-1 others batched with it: bit for bit
+int check_batching_fn(RowsFn fn, int type, std::mt19937& rng) {
+    const int n = 2048, rows = 11;
+    const auto w = rand_rows(type, n, rows, rng);
+    const size_t rb = ggml_row_size((ggml_type) type, n), ab = cpu::iq256a32_bytes(n);
+    std::vector<uint8_t> a(ab * 5);
+    for (int k = 0; k < 5; ++k) cpu::iq256a32_quantize(rand_x(n, rng).data(), n, a.data() + ab * k);
+    std::vector<const void*> ap(5);
+    for (int k = 0; k < 5; ++k) ap[k] = a.data() + ab * k;
+    std::vector<float> one(rows), many((size_t) 5 * rows);
+    float* o1[1] = {one.data()};
+    fn(type, w.data(), rb, n, ap.data(), 1, o1, 0, rows);
+    int bad = 0;
+    for (int nt = 2; nt <= 5; ++nt) {
+        std::vector<float*> om(nt);
+        for (int k = 0; k < nt; ++k) om[k] = many.data() + (size_t) k * rows;
+        fn(type, w.data(), rb, n, ap.data(), nt, om.data(), 0, rows);
+        bad += std::memcmp(one.data(), many.data(), rows * sizeof(float)) != 0;
+    }
+    return bad;
+}
+
+// GLM's split-base path through NativeFmt: nt tokens at once equal each token alone
+int check_native(int gu_type, int d_type, std::mt19937& rng) {
+    cpu::NativeFmt f;
+    std::string err;
+    if (!cpu::native_fmt(gu_type, d_type, 4096, 2048, f, err) || !cpu::native_fmt_a32(f)) {
+        std::printf("  native %s/%s: not switched (%s)\n", ggml_type_name((ggml_type) gu_type), ggml_type_name((ggml_type) d_type),
+                    err.c_str());
+        return 1;
+    }
+    const auto gate = rand_rows(gu_type, 4096, 2048, rng), up = rand_rows(gu_type, 4096, 2048, rng),
+               down = rand_rows(d_type, 2048, 4096, rng);
+    const int nt = 4;
+    std::vector<uint8_t> act(f.act_bytes * nt), hq(f.h_bytes * nt);
+    std::vector<float> ff((size_t) nt * 2048), ff1((size_t) nt * 2048), dn((size_t) nt * 4096), dn1((size_t) nt * 4096);
+    std::vector<const void*> ap(nt), hp(nt);
+    std::vector<float*> fp(nt), dp(nt);
+    for (int k = 0; k < nt; ++k) {
+        cpu::native_quant_act(f, rand_x(4096, rng).data(), act.data() + f.act_bytes * k);
+        ap[k] = act.data() + f.act_bytes * k;
+        fp[k] = ff.data() + (size_t) k * 2048;
+        dp[k] = dn.data() + (size_t) k * 4096;
+    }
+    for (int r0 = 0; r0 < 2048; r0 += 683)
+        cpu::native_gu_rows_split(f, gate.data(), up.data(), ap.data(), nt, fp.data(), r0, std::min(2048, r0 + 683), 10.0f);
+    for (int k = 0; k < nt; ++k) {
+        cpu::native_quant_h(f, ff.data() + (size_t) k * 2048, hq.data() + f.h_bytes * k);
+        hp[k] = hq.data() + f.h_bytes * k;
+    }
+    for (int r0 = 0; r0 < 4096; r0 += 1500)
+        cpu::native_down_rows_split(f, down.data(), hp.data(), nt, dp.data(), r0, std::min(4096, r0 + 1500));
+    int bad = 0;
+    for (int k = 0; k < nt; ++k) {
+        float* o1 = ff1.data() + (size_t) k * 2048;
+        float* p1 = dn1.data() + (size_t) k * 4096;
+        cpu::native_gu_rows_split(f, gate.data(), up.data(), &ap[k], 1, &o1, 0, 2048, 10.0f);
+        cpu::native_down_rows_split(f, down.data(), &hp[k], 1, &p1, 0, 4096);
+        bad += std::memcmp(o1, ff.data() + (size_t) k * 2048, 2048 * sizeof(float)) != 0;
+        bad += std::memcmp(p1, dn.data() + (size_t) k * 4096, 4096 * sizeof(float)) != 0;
+    }
+    return bad;
+}
+
+
+// single-thread timing of rows: ggml's dot with Q8_K activations vs the 32-value rows (plain, device steps)
+void bench(int type, std::mt19937& rng) {
+    const int n = 6144, rows = 512;
+    const auto w = rand_rows(type, n, rows, rng);
+    const size_t rb = ggml_row_size((ggml_type) type, n);
+    const auto* q8k = ggml_get_type_traits_cpu(GGML_TYPE_Q8_K);
+    std::vector<uint8_t> ak(ggml_row_size(GGML_TYPE_Q8_K, n));
+    q8k->from_float(rand_x(n, rng).data(), ak.data(), n);
+    std::vector<uint8_t> a32buf(cpu::iq256a32_bytes(n));
+    cpu::iq256a32_quantize(rand_x(n, rng).data(), n, a32buf.data());
+    const void* ap1[1] = {a32buf.data()};
+    std::vector<float> out(rows);
+    float* op[1] = {out.data()};
+    const auto dot = ggml_get_type_traits_cpu((ggml_type) type)->vec_dot;
+    const auto t = [&](auto&& fn) {
+        double best = 1e9;
+        for (int rep = 0; rep < 7; ++rep) {
+            const auto t0 = std::chrono::steady_clock::now();
+            for (int it = 0; it < 20; ++it) fn();
+            best = std::min(best, std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t0).count() / (20.0 * rows));
+        }
+        return best;
+    };
+    const double g = t([&] { for (int r = 0; r < rows; ++r) dot(n, &out[r], 0, w.data() + (size_t) r * rb, 0, ak.data(), 0, 1); });
+    const double p = t([&] { cpu::iq256a32_rows(type, w.data(), rb, n, ap1, 1, op, 0, rows); });
+    double d = p;
+#ifdef BENCH_DEV
+    d = t([&] { cpu::iq256a32d_rows(type, w.data(), rb, n, ap1, 1, op, 0, rows); });
+#endif
+    std::printf("  bench %-8s ns/row (n=%d): ggml %.0f  a32 %.0f  a32 device-steps %.0f\n", ggml_type_name((ggml_type) type), n,
+                g * 1000, p * 1000, d * 1000);
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    const char* mode = argc > 1 ? argv[1] : "q8_1";   // q8_1 or q8_1d
+#ifdef _WIN32
+    _putenv_s("STRATA_GLM_CPU_ACT", mode);
+#else
+    setenv("STRATA_GLM_CPU_ACT", mode, 1);
+#endif
+    if (!cpu::cpu_avx2_ok()) {
+        std::printf("native_a32_test: no AVX2 here - skipped\n");
+        return 0;
+    }
+    std::mt19937 rng(12345);
+    if (argc > 2 && std::string(argv[2]) == "bench") {
+        for (int type : {16, 18, 22}) bench(type, rng);
+        return 0;
+    }
+    int qbad = 0;
+    for (int n : {256, 2048, 4096, 6144}) qbad += check_quantiser(n, rng);
+    std::printf("  quantiser: %d codes/scales differ from the device's formula\n", qbad);
+    if (qbad != 0) ++failures;
+    for (int type : {16, 17, 18, 21, 22, 23}) {
+        double worst = 0.0;
+        for (int n : {256, 2048, 4096})
+            for (int nt = 1; nt <= 5; ++nt) worst = std::max(worst, compare(type, n, 13, nt, rng));
+        const int batch = check_batching(type, rng);
+        const int batch_d = check_batching_fn(cpu::iq256a32d_rows, type, rng);
+        double dv = 0.0;
+        for (int nt = 1; nt <= 4; ++nt) dv = std::max(dv, dev_vs_plain(type, 2048, 13, nt, rng));
+        std::printf("  %-8s worst |kernel - double reference| / sum|terms| = %.2e, batching differs %d; device-steps rows: "
+                    "batching differs %d, differ from the plain rows by %.2e of the rms\n",
+                    ggml_type_name((ggml_type) type), worst, batch, batch_d, dv);
+        if (worst > 2e-6 || batch != 0 || batch_d != 0 || dv > 2e-3) ++failures;
+    }
+    for (const auto& p : {std::pair<int, int>{16, 18}, {16, 22}, {18, 18}, {21, 23}}) {
+        const int bad = check_native(p.first, p.second, rng);
+        std::printf("  native gate-up %s / down %s: %d results depend on batching\n", ggml_type_name((ggml_type) p.first),
+                    ggml_type_name((ggml_type) p.second), bad);
+        if (bad != 0) ++failures;
+    }
+    // unsupported formats stay on ggml's activations
+    cpu::NativeFmt k;
+    std::string err;
+    if (cpu::native_fmt(12, 12, 4096, 2048, k, err) && cpu::native_fmt_a32(k)) {
+        std::printf("  Q4_K must stay on ggml's activations\n");
+        ++failures;
+    }
+    std::printf(failures == 0 ? "native_a32_test: OK\n" : "native_a32_test: %d FAILED\n", failures);
+    return failures == 0 ? 0 : 1;
+}
