+template <int TY, int NT, bool DEV>
+void dot_rows_a32x(const uint8_t* w, size_t row_bytes, int n, const void* const* act, float* const* out, int r0, int r1) {
+    const float* yd[NT];
+    const int8_t* yq[NT];
+    for (int t = 0; t < NT; ++t) {
+        yd[t] = (const float*) act[t];
+        yq[t] = (const int8_t*) (yd[t] + n / 32);
+    }
+    float res[NT];
+    for (int r = r0; r < r1; ++r) {
+        if constexpr (DEV && (TY == 16 || TY == 17 || TY == 18 || TY == 22))
+            row_dot_a32g<TY, NT>(w + (size_t) r * row_bytes, n / QK_K, yd, yq, res);
+        else
+            row_dot_a32<TY, NT>(w + (size_t) r * row_bytes, n / QK_K, yd, yq, res);
+        for (int t = 0; t < NT; ++t) out[t][r] = res[t];
+    }
