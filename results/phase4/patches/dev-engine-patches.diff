+/// 32-value activation blocks (STRATA_GLM_CPU_ACT=q8_1): the device's q8_1 scheme - a scale (amax / 127, FP16-rounded) per 32
+/// values instead of ggml's Q8_K scale per 256.  n values are n / 32 floats (the scales) then n int8 codes
+/// (iq256a32_bytes).  Rows as iq256_rows' (same weight formats except Q4_K / Q5_K); NOT bit-identical to ggml's dot.
+bool iq256a32_supported(int ggml_type) noexcept;
+size_t iq256a32_bytes(int n) noexcept;
+void iq256a32_quantize(const float* x, int n, void* dst) noexcept;
