+// The device's q8_1 quantiser (glm_fast.cu q8_1_store_warp) for 32 values at a time: d = min(amax / 127, 65504), code =
+// round(v / d) (halves away from zero, as roundf) clamped to +-127, and the scale kept as the FP16 the device stores
+void iq256a32_quantize(const float* x, int n, void* dst) noexcept {
+    float* d = (float*) dst;
+    int8_t* q = (int8_t*) (d + n / 32);
+    for (int b = 0; b < n / 32; ++b) {
+        const float* v = x + 32 * b;
+        float amax = 0.0f;
+        for (int j = 0; j < 32; ++j) amax = std::fmax(amax, std::fabs(v[j]));
+        const float sc = std::fmin(amax / 127.0f, 65504.0f);
+        d[b] = h2f((uint16_t) _mm_cvtsi128_si32(_mm_cvtps_ph(_mm_set_ss(sc), 0)));
+        for (int j = 0; j < 32; ++j)
+            q[32 * b + j] = amax == 0.0f ? (int8_t) 0 : (int8_t) std::fmax(-127.0f, std::fmin(127.0f, std::round(v[j] / sc)));
+    }
