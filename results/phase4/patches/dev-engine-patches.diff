+}
+
+// STRATA_GLM_LANE_AUDIT's worker: one lane call (layer il, ne experts, input x, weights w, the lane's answer out_cpu)
+//  - run on the device (rms_q8 reproduces x as a q8_1, then the fast path's gate/up and down kernels, own stream),
+//  - computed in double from ggml's dequantised rows (the reference, no activation quantisation), and
+//  - emulated with other activation precisions: the dequantised rows against x and h after a quantise-dequantise
+//    round trip in 256-value Q8_K blocks (the lane's), 32-value q8_1 blocks with an FP16 scale (the device's), and finer
+//    blocks.  The integer dots are exact, so these isolate what the activation quantisation alone costs.
+// One JSON line per call to STRATA_GLM_LANE_AUDIT_OUT (default lane-audit.jsonl).
+void Glm5Model::lane_audit(int il, int ne, const uint8_t* blobs, const float* w, const float* x, const float* out_cpu) {
+    FastState* F = fast_;
+    const Glm5Geometry& g = g_;
+    const auto& Ly = F->L[(size_t) il];
+    strata::kernels::cpu::NativeFmt nf = F->cpu_fmt[(size_t) il];
+    strata::kernels::cpu::native_fmt_a32(nf);
+    namespace kc = strata::kernels::cpu;
+    const int E = g.n_embd, FF = g.n_ff_exp;
+    cudaSetDevice(dev_);
+    // ---- the device
+    std::vector<float> og((size_t) E), xg((size_t) E);
+    {
+        cudaStream_t cs;
+        cudaStreamCreateWithFlags(&cs, cudaStreamNonBlocking);
+        float *dh, *dw, *dx, *dout, *dpw;
+        void *dxq, *dhq;
+        uint8_t* dblob;
+        unsigned long long* dpp;
+        int* dflag;
+        cudaMalloc(&dh, (size_t) E * 4);
+        cudaMalloc(&dw, (size_t) E * 4);
+        cudaMalloc(&dx, (size_t) E * 4);
+        cudaMalloc(&dout, (size_t) E * 4);
+        cudaMalloc(&dxq, (size_t) E / 32 * 36);
+        cudaMalloc(&dhq, (size_t) 8 * FF / 32 * 36);
+        cudaMalloc(&dblob, (size_t) ne * nf.bytes);
+        cudaMalloc(&dpp, 8 * sizeof(unsigned long long));
+        cudaMalloc(&dpw, 8 * sizeof(float));
+        cudaMalloc(&dflag, sizeof(int));
+        double ss = 0;
+        for (int i = 0; i < E; ++i) ss += (double) x[i] * x[i];
+        // x = h * rsqrt(mean(h^2) + eps) * wv; wv = sqrt(mean + eps) makes it h itself, and gives the q8_1 of x
+        const float rms = (float) std::sqrt(ss / E + (double) g.norm_eps);
+        std::vector<float> wv((size_t) E, rms);
+        cudaMemcpy(dh, x, (size_t) E * 4, cudaMemcpyHostToDevice);
+        cudaMemcpy(dw, wv.data(), (size_t) E * 4, cudaMemcpyHostToDevice);
+        gf::rms_q8(dh, nullptr, dw, g.norm_eps, E, dx, dxq, cs);
+        cudaMemcpy(dblob, blobs, (size_t) ne * nf.bytes, cudaMemcpyHostToDevice);
+        unsigned long long pp[8] = {};
+        float pw[8] = {};
+        for (int i = 0; i < ne; ++i) {
+            pp[i] = (unsigned long long) (dblob + (size_t) i * nf.bytes);
+            pw[i] = w[i];
+        }
+        cudaMemcpy(dpp, pp, sizeof pp, cudaMemcpyHostToDevice);
+        cudaMemcpy(dpw, pw, sizeof pw, cudaMemcpyHostToDevice);
+        cudaMemset(dflag, 0, sizeof(int));
+        gf::MoeDev amd = F->md;
+        amd.plan_ptr = dpp;
+        amd.plan_w = dpw;
+        amd.cpu_flag = dflag;
+        gf::moe_gate_up(Ly.gu_type, amd, ne, E, FF, g.swiglu_exp, dxq, dhq, nullptr, 0, nullptr, 0, nullptr, cs);
+        gf::moe_down(Ly.d_type, amd, ne, E, FF, Ly.down_off, dhq, nullptr, dout, cs);
+        cudaMemcpyAsync(og.data(), dout, (size_t) E * 4, cudaMemcpyDeviceToHost, cs);
+        cudaMemcpyAsync(xg.data(), dx, (size_t) E * 4, cudaMemcpyDeviceToHost, cs);
+        cudaStreamSynchronize(cs);
+        cudaFree(dh); cudaFree(dw); cudaFree(dx); cudaFree(dout); cudaFree(dxq); cudaFree(dhq); cudaFree(dblob);
+        cudaFree(dpp); cudaFree(dpw); cudaFree(dflag);
+        cudaStreamDestroy(cs);
+    }
+    // ---- the host: reference and activation-precision variants
+    // formats of an activation vector v (n values) after a quantise-dequantise round trip: 0 exact, 1 the lane's own
+    // quantiser (ggml; Q8_K, 256-value blocks), 2/3 blocks of 128/64 with an FP32 scale, 4 q8_1 blocks of 32 with an FP16
+    // scale (the device's), 5/6/7 blocks of 32/16/8 with an FP32 scale, 8 the lane's quantiser twice (the second on the
+    // first's residual: two integer dots)
+    constexpr int NV = 9;
+    const char* const vname[NV] = {"exact", nf.a32 ? "lane32" : "K256", "b128", "b64", "q81", "b32", "b16", "b8",
+                                   nf.a32 ? "lane32x2" : "K256x2"};
+    const auto qdq = [](const float* v, int n, int blk, bool half_scale, float* o) {
+        for (int b = 0; b < n; b += blk) {
+            float amax = 0.0f;
+            for (int j = 0; j < blk; ++j) amax = std::max(amax, std::fabs(v[b + j]));
+            if (amax == 0.0f) {
+                for (int j = 0; j < blk; ++j) o[b + j] = 0.0f;
+                continue;
+            }
+            const float d = std::min(amax / 127.0f, 65504.0f);
+            const float ds = half_scale ? ggml_fp16_to_fp32(ggml_fp32_to_fp16(d)) : d;
+            for (int j = 0; j < blk; ++j) o[b + j] = std::max(-127.0f, std::min(127.0f, std::round(v[b + j] / d))) * ds;
+        }
+    };
+    const auto lane_qdq = [&](const float* v, int n, bool is_x, float* o) {   // the lane's own quantiser, dequantised
+        std::vector<uint8_t> q(kc::kNativeActBytes);
+        if (is_x) kc::native_quant_act(nf, v, q.data()); else kc::native_quant_h(nf, v, q.data());
+        const ggml_type at = (ggml_type) (is_x ? nf.gu_act : nf.d_act);
+        if (nf.a32) {   // the lane's 32-value form: n / 32 float scales, then n int8 codes
+            const float* d = (const float*) q.data();
+            const int8_t* c = (const int8_t*) (d + n / 32);
+            for (int j = 0; j < n; ++j) o[j] = d[j / 32] * (float) c[j];
+        } else if (at == GGML_TYPE_Q8_K) {   // (this ggml has no to_float for it): { float d; int8 qs[256]; int16 bsums[16] }
+            for (int b = 0; b < n / 256; ++b) {
+                const uint8_t* blk = q.data() + (size_t) b * (is_x ? nf.act_bytes : nf.h_bytes) / (size_t) (n / 256);
+                float d;
+                std::memcpy(&d, blk, 4);
+                for (int j = 0; j < 256; ++j) o[(size_t) b * 256 + j] = d * (float) (int8_t) blk[4 + j];
+            }
+        } else if (ggml_get_type_traits(at)->to_float != nullptr) {
+            ggml_get_type_traits(at)->to_float(q.data(), o, n);
+        } else {
+            std::memcpy(o, v, (size_t) n * 4);   // (unknown activation format: reported as exact)
+        }
+    };
+    const auto variants = [&](const float* v, int n, bool is_x, std::vector<float>* o) {
+        for (int k = 0; k < NV; ++k) o[k].assign((size_t) n, 0.0f);
+        std::memcpy(o[0].data(), v, (size_t) n * 4);
+        lane_qdq(v, n, is_x, o[1].data());
+        qdq(v, n, 128, false, o[2].data());
+        qdq(v, n, 64, false, o[3].data());
+        qdq(v, n, 32, true, o[4].data());
+        qdq(v, n, 32, false, o[5].data());
+        qdq(v, n, 16, false, o[6].data());
+        qdq(v, n, 8, false, o[7].data());
+        std::vector<float> res((size_t) n), r2((size_t) n);
+        for (int j = 0; j < n; ++j) res[(size_t) j] = v[j] - o[1][(size_t) j];
+        lane_qdq(res.data(), n, is_x, r2.data());
+        for (int j = 0; j < n; ++j) o[8][(size_t) j] = o[1][(size_t) j] + r2[(size_t) j];
+    };
+    struct Combo { std::string name; int xv, hv; };
+    std::vector<Combo> combos;
+    combos.push_back({"ref", 0, 0});
+    for (int f = 1; f < NV; ++f) combos.push_back({std::string("x_") + vname[f], f, 0});
+    for (int f = 1; f < NV; ++f) combos.push_back({std::string("h_") + vname[f], 0, f});
+    for (int f = 1; f < NV; ++f) combos.push_back({std::string("xh_") + vname[f], f, f});
+    for (int f = 2; f < NV; ++f) combos.push_back({std::string("xlane_h_") + vname[f], 1, f});
+    const int NC = (int) combos.size();
+    int ci_cpu = -1, ci_gpu = -1;
+    for (int k = 0; k < NC; ++k) {
+        if (combos[(size_t) k].name == std::string("xh_") + vname[1]) ci_cpu = k;
+        if (combos[(size_t) k].name == "xh_q81") ci_gpu = k;
+    }
+    const ggml_type_traits* tg = ggml_get_type_traits((ggml_type) Ly.gu_type);
+    const ggml_type_traits* td = ggml_get_type_traits((ggml_type) Ly.d_type);
+    std::vector<float> xs[NV];
+    variants(x, E, true, xs);
+    std::vector<double> hh((size_t) ne * NV * FF);   // [expert][x variant][FF]: the double hidden vector
+    const unsigned nth = 8;
+    const auto par = [&](int rows, const std::function<void(int, int)>& fn) {   // fn(r0, r1) on nth threads
+        std::vector<std::thread> ts;
+        std::atomic<int> next{0};
+        for (unsigned t = 0; t < nth; ++t)
+            ts.emplace_back([&] {
+                for (int r0; (r0 = next.fetch_add(32)) < rows;) fn(r0, std::min(rows, r0 + 32));
+            });
+        for (auto& t : ts) t.join();
+    };
+    std::vector<float> hq_f[8][NV][NV];   // [expert][x variant][h variant]: the quantised-dequantised hidden vector as float
+    for (int i = 0; i < ne; ++i) {
+        const uint8_t* b = blobs + (size_t) i * nf.bytes;
+        par(FF, [&](int r0, int r1) {
+            std::vector<float> row((size_t) E);
+            for (int r = r0; r < r1; ++r) {
+                double gs[NV] = {}, us[NV] = {};
+                tg->to_float(b + (size_t) r * nf.gu_row, row.data(), E);
+                for (int v = 0; v < NV; ++v) for (int c = 0; c < E; ++c) gs[v] += (double) row[(size_t) c] * xs[v][(size_t) c];
+                tg->to_float(b + Ly.gu_bytes + (size_t) r * nf.gu_row, row.data(), E);
+                for (int v = 0; v < NV; ++v) for (int c = 0; c < E; ++c) us[v] += (double) row[(size_t) c] * xs[v][(size_t) c];
+                for (int v = 0; v < NV; ++v) {
+                    const double lim = g.swiglu_exp;
+                    const double gc = std::min(gs[v], lim), uc = std::min(std::max(us[v], -lim), lim);
+                    hh[((size_t) i * NV + v) * FF + r] = gc / (1.0 + std::exp(-gc)) * uc;
+                }
+            }
+        });
+        for (int v = 0; v < NV; ++v) {
+            std::vector<float> hf((size_t) FF);
+            for (int r = 0; r < FF; ++r) hf[(size_t) r] = (float) hh[((size_t) i * NV + v) * FF + r];
+            variants(hf.data(), FF, false, hq_f[i][v]);
+        }
