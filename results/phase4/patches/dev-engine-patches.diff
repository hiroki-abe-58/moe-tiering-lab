+            std::vector<uint8_t> blobs((size_t) ne * nf.bytes);
+            for (int i = 0; i < ne; ++i) std::memcpy(blobs.data() + (size_t) i * nf.bytes, blob[i], nf.bytes);
+            worker = std::thread([this, il, ne, blobs = std::move(blobs), wv = std::vector<float>(w, w + ne),
+                                  xv = std::vector<float>(x, x + n_embd), ov = std::vector<float>(out, out + n_embd)] {
