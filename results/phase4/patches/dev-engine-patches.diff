+bool native_fmt_a32(NativeFmt& f) {
+    static const int mode = [] {   // 0 off, 1: q8_1 blocks, 2: and the device's integer steps
+        const char* v = std::getenv("STRATA_GLM_CPU_ACT");
+        const std::string s = v ? v : "";
+        return s == "q8_1" || s == "32" ? 1 : s == "q8_1d" ? 2 : 0;
+    }();
+    if (mode == 0 || f.n_ff <= 0 || !cpu_avx2_ok() || std::getenv("STRATA_NO_IQ256") != nullptr) return false;
+    if (!iq256a32_supported(f.gu_type) || !iq256a32_supported(f.d_type)) return false;
+    if (f.n_embd % 256 != 0 || f.n_ff % 256 != 0) return false;
+    f.a32 = (uint8_t) mode;
+    f.act_bytes = iq256a32_bytes((int) f.n_embd);
+    f.h_bytes = iq256a32_bytes((int) f.n_ff);
+    if (f.act_bytes > kNativeActBytes || f.h_bytes > kNativeHBytes) {
+        f.a32 = 0;
+        return false;
+    }
+    return true;
+}
